{
  "name": "doomsday-desktop",
  "version": "1.0.1",
  "description": "Doomsday Network - Proof-of-Idle-Work Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "cryptocurrency",
    "mining",
    "pow",
    "cuda",
    "idle-mining",
    "doomsday"
  ],
  "author": "Doomsday Network Contributors",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.doomsday.desktop",
    "productName": "Doomsday",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../core",
        "to": "core"
      },
      {
        "from": "../miner",
        "to": "miner"
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
